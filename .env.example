# ---- Required ----
# Your AssemblyAI API key (https://www.assemblyai.com/app → API Keys)
ASSEMBLYAI_API_KEY=

# Public HTTPS URL of THIS server. AssemblyAI's Voice Agent calls tools on it.
# Local dev: use `ngrok http 8000` and paste the https URL here.
# Production: your Render/Railway/Fly URL, e.g. https://ringback.onrender.com
PUBLIC_BASE_URL=

# ---- Optional ----
# Voice from the AssemblyAI catalog (default: alba)
ASSEMBLYAI_VOICE=alba

# Model behind the post-call analytics (LLM Gateway). Cheap+fast by default.
AAI_ANALYTICS_MODEL=gemini-2.5-flash-lite

# Token lifetime / max session in seconds
AAI_TOKEN_TTL=300
AAI_MAX_SESSION=900

# Server port (Render injects $PORT)
PORT=8000

# Seed the 4 demo businesses on boot (true/false)
SEED_DEMO=true

# Average $ value of one recovered call, used for the revenue estimator
AVG_CALL_VALUE=125